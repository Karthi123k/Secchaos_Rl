\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Ablation Study: Architectural Component Analysis Across 30 Independent Random Seeds. Panel A presents absolute metrics (Mean $\pm $ Std. Dev.). Panel B reports paired differences between successive stages ($\Delta = \text  {Stage}_k - \text  {Stage}_{k-1}$) and overall (Stage 6 vs. Stage 1) with 95\% confidence intervals, paired $t$-tests ($t$, unadjusted $p$), and Cohen's $d$.}}{12}{table.caption.8}\protected@file@percent }
